# Supabase (상담 저장소) — supabase.com 프로젝트 생성 후 채우기
# Project Settings → Data API → Project URL
SUPABASE_URL=
# Project Settings → API Keys → service_role (secret, 절대 공개 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 판매자(/admin) 로그인 비밀번호 — 원하는 값으로
ADMIN_PASSWORD=

# 카카오 지도 JavaScript 키 — developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# 플랫폼 설정에 http://localhost:3000 과 실제 배포 도메인 등록 필수
# (도메인을 새로 연결하면 여기에도 반드시 추가 — 안 하면 지도가 안 뜸)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── 새 상담 알림 ① 카카오 알림톡 (주 채널, 솔라피) ──
# 6개가 모두 있어야 발송된다. 준비: 카카오 채널 개설 → 솔라피 가입·사업자인증
#  → 채널 연동(pfId 발급) → 템플릿 등록·카카오 심사(영업일 최대 3일) → API 키 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 발신프로필 ID — 솔라피에 카카오 채널을 연동하면 발급됨
SOLAPI_PFID=
# 심사 통과한 템플릿 ID
SOLAPI_TEMPLATE_ID=
# 발신번호 — 솔라피에 사전 등록된 번호여야 함 (매장 전화)
SOLAPI_SENDER_PHONE=
# 받는 사람: 사장님 휴대폰 번호 (알림톡이 도착할 곳)
INQUIRY_NOTIFY_PHONE=

# ── 새 상담 알림 ② 이메일 (알림톡이 못 나갔을 때의 대비책, Brevo) ──
# brevo.com 가입 → Senders 에서 보내는 주소 인증 → SMTP & API 메뉴에서 API 키 발급
BREVO_API_KEY=
# 받는 사람: 사장님 이메일
INQUIRY_NOTIFY_TO=
# 보내는 사람: Brevo에서 인증을 마친 주소여야 함
INQUIRY_NOTIFY_FROM=

# 검색엔진 소유확인 코드 (선택) — 서치어드바이저/서치콘솔에서 발급받은 값
NEXT_PUBLIC_NAVER_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# 구글 애널리틱스(GA4) 측정 ID (선택) — analytics.google.com에서 속성 생성 후
# 관리 → 데이터 스트림 → 웹 스트림에서 확인 (G-로 시작하는 값)
NEXT_PUBLIC_GA_ID=

# 배포 도메인 — 도메인 연결 후 새 주소로 교체 (sitemap·canonical·OG에 모두 반영됨)
NEXT_PUBLIC_SITE_URL=
