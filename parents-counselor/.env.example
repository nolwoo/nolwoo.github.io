# 아래에 Anthropic API 키를 넣고, 이 파일을 .env 라는 이름으로 복사하세요.
# 키 발급: https://console.anthropic.com/  (Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-여기에-키-붙여넣기

# ── (선택, 배포 시 권장) 사용량 제한 저장소: Upstash Redis ──
# 비워 두면 서버 메모리로 제한합니다. Vercel 서버리스에서는 인스턴스마다 따로 세서 느슨합니다.
# upstash.com에서 Redis 데이터베이스를 만든 뒤 REST API의 URL과 TOKEN을 Vercel 환경변수에 넣으세요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 서비스 전체 하루 최대 호출 수 (Redis를 쓸 때만 적용, 기본 1000)
GLOBAL_MAX_PER_DAY=1000
